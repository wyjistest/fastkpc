+bool pinned_optimizer_io_enabled() {
+  const char* raw = std::getenv("FASTKPC_MULTI_PENALTY_PINNED_IO");
+  if (raw == nullptr || raw[0] == '\0' || std::string(raw) == "0") {
+    return false;
+  }
+  if (std::string(raw) == "1") return true;
+  throw std::runtime_error("FASTKPC_MULTI_PENALTY_PINNED_IO must be 0 or 1");
+}
+
+template <typename T>
+class PinnedHostBuffer {
+ public:
+  PinnedHostBuffer() = default;
+  PinnedHostBuffer(const PinnedHostBuffer&) = delete;
+  PinnedHostBuffer& operator=(const PinnedHostBuffer&) = delete;
+  ~PinnedHostBuffer() { reset(); }
+
+  void allocate(std::size_t count) {
+    if (data_ != nullptr || count == 0 ||
+        count > std::numeric_limits<std::size_t>::max() / sizeof(T)) {
+      throw std::runtime_error("invalid pinned optimizer buffer capacity");
+    }
+    check_cuda(cudaMallocHost(reinterpret_cast<void**>(&data_),
+                              count * sizeof(T)),
+               "allocate pinned optimizer host buffer");
+  }
+
+  void reset() {
+    if (data_ != nullptr) cudaFreeHost(data_);
+    data_ = nullptr;
+  }
+
+  T* get() { return data_; }
+
+ private:
+  T* data_ = nullptr;
+};
